# -----------------------------------------------------------------------------
# Ironstone Backend Environment Configuration
# -----------------------------------------------------------------------------

# Port for the Node.js server (Render automatically sets this, default 4100)
PORT=4100

# Public URL where the frontend is hosted.
# Puppeteer opens ${FRONTEND_BASE_URL}/export-render/:projectId to capture PDFs.
# - Local dev: http://localhost:5173
# - Production: https://yourdomain.com (or https://ironstone-frontend.onrender.com)
FRONTEND_BASE_URL=http://localhost:5173

# Secret key used to sign transient export render tokens (min 32 characters)
EXPORT_TOKEN_SECRET=replace_with_a_long_random_secret_string

# Resend API Key for sending PDF emails (optional, https://resend.com)
RESEND_API_KEY=

# From email address for PDF delivery
RESEND_FROM=Ironstone <onboarding@resend.dev>

# Pinterest API Access Token (optional, scraper fallback works without it)
PINTEREST_ACCESS_TOKEN=

# Maximum exports allowed per IP per day (default 10)
MAX_EXPORTS_PER_IP_PER_DAY=10

# Maximum concurrent Puppeteer renders (default 2)
MAX_CONCURRENT_EXPORTS=2
