# -----------------------------------------------------------------------------
# Ironstone Frontend Environment Configuration
# -----------------------------------------------------------------------------

# Backend API URL:
# - Local dev: Leave empty (Vite dev proxy forwards /api and /export to http://localhost:4100)
#   or set to http://localhost:4100
# - Production on Render: Set to your live backend service URL, e.g.:
#   https://ironstone-backend.onrender.com (or https://api.yourdomain.com)
VITE_API_URL=https://ironstone-backend.onrender.com
